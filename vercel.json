{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/privacidade", "destination": "/pages/privacidade.html" },
    { "source": "/offline", "destination": "/pages/offline.html" },
    { "source": "/403", "destination": "/pages/403.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
